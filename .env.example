POSTGRES_DB=aic_hcmc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
API_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/aic_hcmc

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PORT=9200

# Module 3.1 - Visual Retrieval Tools
FAISS_INDEX_DIR=/app/artifacts/faiss
TEXT_EMBEDDING_MODEL_NAME=sentence-transformers/clip-ViT-B-32-multilingual-v1
FAISS_INDEX_MODEL_NAME=clip-ViT-B-32
CLIP_MODEL_NAME=clip-ViT-B-32

# CUDA runtime for online-api. Requires NVIDIA Container Toolkit.
API_GPUS=all
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
TORCH_PACKAGE=torch==2.3.1+cu121
CLIP_MODEL_DEVICE=cuda

# CPU fallback for machines without NVIDIA GPU:
# API_GPUS=
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# TORCH_PACKAGE=torch==2.3.1+cpu
# CLIP_MODEL_DEVICE=cpu

FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_LLM_MODEL=Qwen3.6-27B
FPT_VLM_MODEL=Qwen2.5-VL-7B-Instruct

SELECTIVE_VERIFIER_ENABLED=false
RETRIEVAL_V2_ENABLED=false
RETRIEVAL_V2_RAW_TARGET=2000
RETRIEVAL_V2_RAW_MAX=3000
RETRIEVAL_V2_UNIQUE_MIN=1600
RETRIEVAL_V2_UNIQUE_MAX=2000
RETRIEVAL_V2_BAND_LIMIT=500
RETRIEVAL_V2_VIDEO_LIMIT=40
RETRIEVAL_V2_LOCAL_K=1000
RETRIEVAL_V2_RETRY_K=500
RETRIEVAL_V2_RERANK_LIMIT=100
RETRIEVAL_V2_REVIEW_LIMIT=7
RETRIEVAL_V2_MAX_RETRIES=2
# Optional versioned artifacts. Leave unset until the offline builders have run.
RETRIEVAL_V2_CORPUS_STATS_PATH=/app/artifacts/retrieval/corpus_stats.json
RETRIEVAL_V2_VIDEO_INDEX_PATH=/app/artifacts/retrieval/video_index.npz
VQA_MAX_CANDIDATES=30
CANDIDATE_MERGE_GAP_MS=2000
VQA_API_KEY=
VQA_BASE_URL=https://mkp-api.fptcloud.com
VQA_MODEL=
VQA_TIMEOUT_SECONDS=60
