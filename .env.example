DATABASE_URL="postgresql+psycopg://<user_name>:<password>@localhost:5432/<db_name>"

# Module 3.1 - Visual Retrieval Tools
FAISS_INDEX_DIR=./BackEnd/data/faiss
# Vietnamese text -> existing CLIP image FAISS vectors.
TEXT_EMBEDDING_MODEL_NAME=sentence-transformers/clip-ViT-B-32-multilingual-v1
# The model identity used to build and resolve the existing FAISS indexes.
FAISS_INDEX_MODEL_NAME=clip-ViT-B-32
# Legacy alias for FAISS_INDEX_MODEL_NAME; keep only for older deployments.
CLIP_MODEL_NAME=clip-ViT-B-32
CLIP_MODEL_DEVICE=cpu
