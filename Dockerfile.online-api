FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/root/.cache/huggingface

WORKDIR /app

COPY requirements.online-api.txt ./requirements.online-api.txt

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
ARG TORCH_PACKAGE=torch==2.3.1+cu121
RUN pip install --no-cache-dir --index-url ${TORCH_INDEX_URL} ${TORCH_PACKAGE}
RUN pip install --no-cache-dir -r requirements.online-api.txt

COPY BackEnd ./BackEnd

EXPOSE 8000

CMD ["uvicorn", "BackEnd.main:app", "--host", "0.0.0.0", "--port", "8000"]
