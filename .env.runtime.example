POSTGRES_DB=aic_hcmc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

API_PORT=8000
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms4g -Xmx4g

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/aic_hcmc
ELASTICSEARCH_URL=http://elasticsearch:9200
FAISS_INDEX_DIR=/app/artifacts/faiss
TEXT_EMBEDDING_MODEL_NAME=sentence-transformers/clip-ViT-B-32-multilingual-v1
FAISS_INDEX_MODEL_NAME=clip-ViT-B-32
CLIP_MODEL_NAME=clip-ViT-B-32
CLIP_MODEL_DEVICE=cpu

FPT_API_KEY=your-api-key
FPT_BASE_URL=https://mkp-api.fptcloud.com

SELECTIVE_VERIFIER_ENABLED=false
VQA_MAX_CANDIDATES=10
CANDIDATE_MERGE_GAP_MS=2000

VQA_API_KEY=
VQA_BASE_URL=https://mkp-api.fptcloud.com
VQA_MODEL=
VQA_TIMEOUT_SECONDS=60
